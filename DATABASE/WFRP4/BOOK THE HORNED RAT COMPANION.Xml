<Talent id="HORNE-T0196">
<Attribut>""</Attribut>
<Description language="ENGLISH">"Tail Fighting"</Description>
<Short language="ENGLISH">""</Short>
<Explanation language="ENGLISH">"You possess a tail, and are adept at using it for fine manipulation. You may use your tail for any task that would normally require a hand. Additionally, you may make one additional attack with a suitably designed Tail Weapon on your turn."</Explanation>
<Skill>""</Skill>
<Max>"1"</Max>
<PDF>""</PDF>
<Test language="ENGLISH">"Any Melee Test involving a Tail weapon"</Test>
</Talent>
